{
  "name": "yanji-beta",
  "version": "1.5.0-beta.2",
  "description": "Local-first research workbench with schedules, notes, and manuscript tracking for Windows",
  "main": "src/main.js",
  "author": "Yanji contributors",
  "license": "MIT",
  "private": true,
  "packageManager": "npm@11.17.0",
  "scripts": {
    "start": "electron .",
    "test": "node --test",
    "pack": "electron-builder --dir",
    "dist": "electron-builder --win nsis --x64 --publish never",
    "metadata:update": "node scripts/generate-update-metadata.js",
    "smoke:packaged": "node scripts/packaged-smoke.js",
    "verify:package": "node scripts/verify-package.js",
    "test:server": "npm test --prefix server",
    "smoke:v15": "electron scripts/smoke-v15.js",
    "brand:generate": "node scripts/generate-icon.js"
  },
  "dependencies": {
    "electron-updater": "6.8.9",
    "fs-extra": "10.1.0",
    "universalify": "2.0.1"
  },
  "devDependencies": {
    "@electron/asar": "3.4.1",
    "electron": "43.2.0",
    "electron-builder": "26.11.1"
  },
  "build": {
    "appId": "io.papertrail.desktop.beta",
    "productName": "研迹测试版",
    "asar": true,
    "asarUnpack": [
      "build/icon.ico",
      "build/icon.png"
    ],
    "compression": "maximum",
    "directories": {
      "output": "outputs-beta"
    },
    "files": [
      "src/**/*",
      "build/icon.png",
      "build/icon.ico",
      "package.json",
      "README.md",
      "LICENSE",
      "THIRD_PARTY_NOTICES.md"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "artifactName": "Yanji-Beta-Setup-${version}-${arch}.${ext}",
      "oneClick": false,
      "include": "build/installer-beta.nsh",
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "研迹测试版",
      "uninstallDisplayName": "研迹测试版",
      "perMachine": false
    },
    "publish": null,
    "executableName": "Yanji-Beta"
  }
}
