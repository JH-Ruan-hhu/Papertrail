{
  "name": "papertrail-desktop",
  "version": "1.3.6",
  "description": "Local-first research workbench with schedules, notes, and manuscript tracking for Windows",
  "main": "src/main.js",
  "author": "Yanji contributors",
  "license": "MIT",
  "private": true,
  "packageManager": "npm@11.17.0",
  "scripts": {
    "start": "electron .",
    "test": "node --test",
    "pack": "electron-builder --dir",
    "dist": "electron-builder --win nsis --x64",
    "smoke:packaged": "node scripts/packaged-smoke.js",
    "verify:package": "node scripts/verify-package.js"
  },
  "dependencies": {
    "electron-updater": "6.8.9",
    "fs-extra": "10.1.0"
  },
  "devDependencies": {
    "@electron/asar": "3.4.1",
    "electron": "43.2.0",
    "electron-builder": "26.11.1"
  },
  "build": {
    "appId": "io.papertrail.desktop",
    "productName": "研迹",
    "asar": true,
    "asarUnpack": [
      "src/windows-desktop-icons.ps1",
      "build/icon.ico",
      "build/icon.png"
    ],
    "compression": "maximum",
    "directories": {
      "output": "outputs"
    },
    "files": [
      "src/**/*",
      "build/icon.png",
      "build/icon.ico",
      "package.json",
      "README.md",
      "LICENSE",
      "THIRD_PARTY_NOTICES.md"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "artifactName": "Yanji-Setup-${version}-${arch}.${ext}",
      "oneClick": false,
      "include": "build/installer.nsh",
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "publish": [
      {
        "provider": "github",
        "owner": "JH-Ruan-hhu",
        "repo": "Papertrail",
        "releaseType": "release"
      }
    ]
  }
}
